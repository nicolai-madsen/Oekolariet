{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Settings for the login token (JWT). The secret key is NOT here, because this file is in Git.
  "Jwt": {
    "Issuer": "Oekolariet.Api", // who creates the token: our API
    "Audience": "Oekolariet.Cms", // who the token is for: the CMS
    "LifetimeHours": 8 // the token is valid for 8 hours (openapi.yaml)
  }
}
