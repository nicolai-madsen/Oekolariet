@page "/sorteringsquiz"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Oekolariet.Shared.Games
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Sortér affaldet</PageTitle>

<RadzenStack Gap="1rem" Style="max-width: 40rem;">
	<h1>Sortér affaldet</h1>

	@if (currentItem is null)
	{
		<h2>Vælg din avatar</h2>

		<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
			@foreach (var avatar in Avatars)
			{
				var isSelected = selectedAvatarKey == avatar.Key;

				<button @key="avatar.Key"
						type="button"
						disabled="@isBusy"
						aria-pressed="@(isSelected ? "true" : "false")"
						@onclick="() => SelectAvatar(avatar.Key)"
						style="padding: 0.5rem; border-radius: 0.75rem; background: white;
					border: 3px solid @(isSelected ? "#356344" : "#ccc");">
					<img src="@($"images/Avatars/{avatar.FileName}")"
						 alt=""
						 width="80"
						 height="80"
						 style="display: block; object-fit: contain;" />
					<span>@avatar.Name</span>
				</button>
			}
		</div>

		<RadzenButton Text="Start spil"
					  Click="@StartGameAsync"
					  Disabled="@(isBusy || selectedAvatarKey is null)" />
	}
	else
	{
		<p>Træk genstanden hen til den rigtige spand.</p>
	}

	@* Keep the same element between items so its pointer handlers stay attached. *@
	<div @ref="itemElement"
		 hidden="@(currentItem is null)"
		 style="width: fit-content; position: relative; z-index: 1; touch-action: none;">
		<RadzenCard Style="padding: 1rem 2rem; cursor: grab;">
			@currentItem?.Name
		</RadzenCard>
	</div>

	@if (currentItem is not null && game is not null)
	{
		<RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
			@foreach (var category in game.Categories)
			{
				<div @key="category.Id" data-bin="@category.Id" style="@BinStyle">
					<strong>@category.Name</strong>
				</div>
			}
		</RadzenStack>
	}

	<p role="status">@feedback</p>
</RadzenStack>

@code {
	private const string BinStyle =
		"flex: 1; min-height: 7rem; padding: 1rem; border: 2px dashed #52745c; border-radius: 0.5rem;";

	private sealed record AvatarOption(string Key, string Name, string FileName);

	// The key is stored with the game and stays valid if the image file is renamed.
	private static readonly AvatarOption[] Avatars =
	[
		new("odder", "Otto Odder", "otto-default.png"),
		new("egern", "Egern", "EgernAvatar.png"),
		new("froe", "Frø", "FroeAvatar.png"),
		new("graevling", "Grævling", "GraevlingAvatar.png"),
		new("pindsvin", "Pindsvin", "PindsvinAvatar.png")
	];

	private string? selectedAvatarKey;
	private ElementReference itemElement;
	private IJSObjectReference? dragModule;
	private DotNetObjectReference<SortingQuiz>? componentReference;

	private SortingGameDto? game;
	private Queue<GuestItemDto> remainingItems = new();
	private GuestItemDto? currentItem;
	private bool isBusy;
	private string feedback = string.Empty;

	private void SelectAvatar(string key)
	{
		selectedAvatarKey = key;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			dragModule = await JS.InvokeAsync<IJSObjectReference>(
				"import", "./sortingGame.js");

			componentReference = DotNetObjectReference.Create(this);

			await dragModule.InvokeVoidAsync(
				"enableImmediateDrag", itemElement, componentReference);
		}
	}

	private async Task StartGameAsync()
	{
		var avatarKey = selectedAvatarKey;

		if (isBusy || avatarKey is null)
		{
			return;
		}

		if (!Guid.TryParse(Configuration["ExhibitionId"], out var exhibitionId))
		{
			feedback = "Udstillingens id mangler eller er ugyldigt.";
			return;
		}

		isBusy = true;
		feedback = string.Empty;

		try
		{
			using var response = await Http.PostAsJsonAsync(
				"api/v1/games", new StartGameRequest(exhibitionId, avatarKey));

			response.EnsureSuccessStatusCode();

			var result = await response.Content.ReadFromJsonAsync<GameDto>();
			if (result is not SortingGameDto sortingGame || sortingGame.Items.Count == 0)
			{
				feedback = "Der er ingen genstande at sortere.";
				return;
			}

			game = sortingGame;

			// Shuffle once per round so each item is shown at most once.
			var items = sortingGame.Items.ToArray();
			Random.Shared.Shuffle(items);
			remainingItems = new Queue<GuestItemDto>(items);
			currentItem = remainingItems.Dequeue();

			// The next guest starts with a fresh avatar selection.
			selectedAvatarKey = null;
		}
		catch (HttpRequestException)
		{
			feedback = "Spillet kunne ikke startes. Prøv igen.";
		}
		finally
		{
			isBusy = false;
		}
	}

	[JSInvokable]
	public async Task HandleBinDrop(string bin)
	{
		if (isBusy || game is null || currentItem is null ||
			!Guid.TryParse(bin, out var categoryId))
		{
			return;
		}

		isBusy = true;

		try
		{
			var request = new AnswerRequest(currentItem.Id, categoryId);

			using var response = await Http.PostAsJsonAsync(
				$"api/v1/games/{game.GameId}/answers", request);

			if (response.StatusCode == HttpStatusCode.Conflict)
			{
				currentItem = null;
				feedback = "Tiden er udløbet, eller genstanden er allerede besvaret. Start en ny runde.";
				return;
			}

			response.EnsureSuccessStatusCode();

			var result = await response.Content.ReadFromJsonAsync<AnswerResultDto>();
			if (result is null)
			{
				feedback = "Svaret fra spillet kunne ikke læses.";
				return;
			}

			feedback = result.IsCorrect ? "Rigtigt!" : "Forkert.";

			if (!string.IsNullOrWhiteSpace(result.Explanation))
			{
				feedback += $" {result.Explanation}";
			}

			if (result.IsGameCompleted || remainingItems.Count == 0)
			{
				currentItem = null;
				feedback += " Runden er slut.";
			}
			else
			{
				currentItem = remainingItems.Dequeue();
			}
		}
		catch (HttpRequestException)
		{
			feedback = "Svaret kunne ikke bekræftes. Prøv igen.";
		}
		finally
		{
			isBusy = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	public async ValueTask DisposeAsync()
	{
		componentReference?.Dispose();

		if (dragModule is not null)
		{
			await dragModule.DisposeAsync();
		}
	}
}
