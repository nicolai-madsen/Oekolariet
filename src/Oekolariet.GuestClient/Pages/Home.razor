@page "/"
@using Microsoft.Extensions.Configuration
@using Oekolariet.Shared.Exhibitions
@inject HttpClient Http
@inject IConfiguration Configuration

<PageTitle>Økolariet</PageTitle>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_version is null)
{
    <p>Henter udstillingen …</p>
}
else
{
    <main class="home-bg" style="@($"--font-family: {_version.Theme.FontFamily}; {BackgroundStyle}")">
        <RadzenStack AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" class="home-banner">
                @(_welcome?.Title ?? "Økolariet")
            </RadzenText>
        </RadzenStack>

        <RadzenRow Gap="2rem" class="home-layout">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenCard class="otto-bubble">
                        <RadzenText TextStyle="TextStyle.Body1">@(_welcome?.Body ?? "")</RadzenText>
                    </RadzenCard>
                    <RadzenImage Path="@OttoImage" AlternateText="Otto Odder" class="otto-img" />
                </RadzenStack>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="8">
                <RadzenRow Gap="1.5rem" AlignItems="AlignItems.Start">
                    @foreach (var area in Areas)
                    {
                        <RadzenColumn Size="6">
                            <RadzenLink Path="@area.Url" class="note" Style="@($"--tilt: {area.Tilt}deg;")">
                                <RadzenImage Path="@area.Paper" AlternateText="" class="note-paper" />
                                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" class="note-title">@area.Title</RadzenText>
                                @if (area.Art is not null)
                                {
                                    <RadzenImage Path="@area.Art" AlternateText="" class="note-art" />
                                }
                            </RadzenLink>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </main>
}

@code {
    private ActiveVersionDto? _version;
    private string? _error;

    // The first page from the API is the welcome text (title, body and optional picture).
    private PageDto? _welcome => _version?.Pages.OrderBy(p => p.Order).FirstOrDefault();

    // Only design, the post-its are permanent 
    // Title and picture will come from the API when it exists
    private static readonly Slot[] Slots =
    [
        new("Hierarchy", "", "images/green-postit.png", -1),
        new("Quiz", "/sorteringsquiz", "images/yellow-postit.png", 1),
        new("Journey", "", "images/blue-postit.png", 1),
        new("Offer", "", "images/pink-postit.png", -1),
    ];
    private IEnumerable<Area> Areas => Slots.Select(slot =>
    {
        var tile = _version?.Tiles.FirstOrDefault(t =>
            string.Equals(t.Type, slot.Key, StringComparison.OrdinalIgnoreCase));

        return new Area(
            Title: tile?.Title ?? "",
            slot.Url,
            slot.Paper,
            Art: null,
            slot.Tilt);
    });

    // Media from the API once GET /media/{id} exists
    private string OttoImage =>
        _welcome?.MediaId is { } id ? MediaUrl(id) : "images/otto-wave.png";

    private string BackgroundStyle =>
        _version?.Theme.BackgroundMediaId is { } id
            ? $"background-image: url('{MediaUrl(id)}');"
            : "";

    private string MediaUrl(Guid id) =>
        new Uri(Http.BaseAddress!, $"api/v1/media/{id}").ToString();

    protected override async Task OnInitializedAsync()
    {
        var exhibitionId = Configuration["ExhibitionId"];

        try
        {
            _version = await Http.GetFromJsonAsync<ActiveVersionDto>(
                $"api/v1/exhibitions/{exhibitionId}/active-version");
        }
        catch (HttpRequestException ex)
        {
            _error = $"Kunne ikke hente udstillingen ({ex.StatusCode}).";
        }
    }
    private sealed record Slot(string Key, string Url, string Paper, int Tilt);

    private sealed record Area(string Title, string Url, string Paper, string? Art, int Tilt);


}
